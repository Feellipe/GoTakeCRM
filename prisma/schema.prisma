// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
//
// DEVELOPMENT: Uses SQLite (local file-based database)
// PRODUCTION: Use schema.prod.prisma with PostgreSQL (Supabase)
// To switch: copy schema.prod.prisma over this file, update DATABASE_URL,
// and run: npx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Client - represents a customer (filmmaker/photographer client)
model Client {
  id          String   @id @default(cuid())
  phone       String   @unique
  name        String
  email       String?
  eventType   String   // wedding, corporate, portrait, product, etc.
  notes       String?
  source      String   @default("whatsapp") // whatsapp, referral, website
  status      String   @default("active") // active, lead, inactive
  avatar      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  deals       Deal[]
  conversations Conversation[]
  bookings    Booking[]
  documents   Document[]
  proposals   Proposal[]

  @@index([status])
}

// Deal - the central entity linking all project data
model Deal {
  id          String   @id @default(cuid())
  clientId    String
  title       String
  description String?
  status      String   @default("new") // new, briefing, quoting, production, completed
  value       Float    @default(0)
  currency    String   @default("BRL")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  briefings   Briefing[]
  expenses    Expense[]
  revenue     Revenue[]
  bookings    Booking[]
  documents   Document[]
  proposals   Proposal[]

  @@index([status])
  @@index([clientId])
}

// Briefing - creative requirements captured per project
model Briefing {
  id          String   @id @default(cuid())
  dealId      String
  content     String
  author      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  deal        Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
}

// Expense - project-specific expenses
model Expense {
  id          String   @id @default(cuid())
  dealId      String
  category    String   // equipment, location, crew, props, travel, other
  description String
  amount      Float
  currency    String   @default("BRL")
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  deal        Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
}

// Revenue - project payments received
model Revenue {
  id          String   @id @default(cuid())
  dealId      String
  description String?
  amount      Float
  currency    String   @default("BRL")
  date        DateTime @default(now())
  status      String   @default("received") // pending, received
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  deal        Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
}

// Conversation - WhatsApp conversation threads
model Conversation {
  id          String   @id @default(cuid())
  clientId    String
  status      String   @default("active") // active, closed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  messages    Message[]
}

// Message - individual messages in conversations
model Message {
  id              String   @id @default(cuid())
  conversationId  String
  direction       String   // inbound, outbound
  type            String   // text, image, document, interactive
  content         String
  status          String   @default("sent") // sent, delivered, read
  createdAt       DateTime @default(now())

  // Relations
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

// Booking - calendar bookings/shoots
model Booking {
  id              String   @id @default(cuid())
  clientId        String
  dealId          String?
  eventType       String
  eventDate       DateTime
  duration        Int      @default(60) // in minutes
  location        String?
  status          String   @default("pending") // pending, confirmed, completed, cancelled
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  deal            Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([eventDate])
  @@index([status])
  @@index([clientId])
}

// Document - PDFs generated and sent
model Document {
  id          String   @id @default(cuid())
  clientId    String
  dealId      String?
  type        String   // contract, quote, invoice, moodboard, other
  title       String
  filename    String
  storageUrl  String
  sentAt      DateTime?
  status      String   @default("draft") // draft, sent, viewed, signed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  deal        Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)
}

// Template - document templates for PDF generation
model Template {
  id          String   @id @default(cuid())
  type        String   // contract, quote, invoice
  title       String
  bodyHtml    String
  variables   String   // JSON string of variable names
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Package - pre-registered service packages for proposals
model Package {
  id          String   @id @default(cuid())
  name        String
  description String
  price       Float
  currency    String   @default("BRL")
  deliverables String  // JSON string of deliverable items
  duration    Int      // in hours
  category    String   @default("photography") // photography, videography, both
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ProposalTemplate - templates for proposals
model ProposalTemplate {
  id              String   @id @default(cuid())
  name            String
  description     String?
  defaultTerms    String?
  defaultPackages String?  // JSON array of package IDs
  coverImage      String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  proposals       Proposal[]
}

// Proposal - deal proposals for negotiation
model Proposal {
  id              String   @id @default(cuid())
  clientId        String
  dealId          String?  // Optional link to a specific deal
  templateId      String?
  title           String
  description     String?
  status          String   @default("draft") // draft, sent, viewed, accepted, rejected, expired
  packages        String   // JSON array of selected packages with custom prices
  customItems     String?  // JSON array of custom line items
  portfolioLinks  String?  // JSON array of portfolio links
  terms           String?  // Custom terms and conditions
  validUntil      DateTime?
  totalValue      Float    @default(0)
  currency        String   @default("BRL")
  notes           String?
  sentAt          DateTime?
  viewedAt        DateTime?
  respondedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  deal            Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)
  template        ProposalTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
}

// Dashboard Settings
model DashboardSettings {
  id              String   @id @default(cuid())
  businessName    String   @default("My Studio")
  currency        String   @default("BRL")
  timezone        String   @default("America/Sao_Paulo")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
