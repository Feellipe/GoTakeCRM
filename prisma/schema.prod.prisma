// Schema de producao para PostgreSQL (Supabase)
// Para usar: defina DATABASE_URL com a string de conexao do Supabase
// Comando: npx prisma db push --schema=prisma/schema.prod.prisma
//
// Exemplo .env para producao:
// DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Client - representa um cliente (cliente de filmmaker/photographer)
model Client {
  id          String   @id @default(cuid())
  phone       String   @unique
  name        String
  email       String?
  eventType   String   @map("event_type")
  notes       String?
  source      String   @default("whatsapp") // whatsapp, referral, website
  status      String   @default("active") // active, lead, inactive
  avatar      String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relacoes
  deals       Deal[]
  conversations Conversation[]
  bookings    Booking[]
  documents   Document[]
  proposals   Proposal[]

  @@index([status])
  @@map("clients")
}

// Deal - entidade central que conecta todos os dados do projeto
model Deal {
  id          String   @id @default(cuid())
  clientId    String   @map("client_id")
  title       String
  description String?
  status      String   @default("novo") // novo, briefing, contando, producao, finalizado
  value       Float    @default(0)
  currency    String   @default("BRL")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relacoes
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  briefings   Briefing[]
  expenses    Expense[]
  revenue     Revenue[]
  bookings    Booking[]
  documents   Document[]
  proposals   Proposal[]

  @@index([status])
  @@index([clientId])
  @@map("deals")
}

// Briefing - requisitos criativos capturados por projeto
model Briefing {
  id          String   @id @default(cuid())
  dealId      String   @map("deal_id")
  content     String
  author      String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relacoes
  deal        Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@map("briefings")
}

// Expense - despesas especificas do projeto
model Expense {
  id          String   @id @default(cuid())
  dealId      String   @map("deal_id")
  category    String   // equipment, location, crew, props, travel, other
  description String
  amount      Float
  currency    String   @default("BRL")
  date        DateTime @default(now())
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relacoes
  deal        Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@map("expenses")
}

// Revenue - pagamentos recebidos do projeto
model Revenue {
  id          String   @id @default(cuid())
  dealId      String   @map("deal_id")
  description String?
  amount      Float
  currency    String   @default("BRL")
  date        DateTime @default(now())
  status      String   @default("received") // pending, received
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relacoes
  deal        Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@map("revenues")
}

// Conversation - threads de conversa do WhatsApp
model Conversation {
  id          String   @id @default(cuid())
  clientId    String   @map("client_id")
  status      String   @default("active") // active, closed
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relacoes
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  messages    Message[]

  @@index([clientId])
  @@map("conversations")
}

// Message - mensagens individuais nas conversas
model Message {
  id              String   @id @default(cuid())
  conversationId  String   @map("conversation_id")
  direction       String   // inbound, outbound
  type            String   // text, image, document, interactive
  content         String
  status          String   @default("sent") // sent, delivered, read
  createdAt       DateTime @default(now()) @map("created_at")

  // Relacoes
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}

// Booking - reservas/agendamentos de calendario
model Booking {
  id              String   @id @default(cuid())
  clientId        String   @map("client_id")
  dealId          String?  @map("deal_id")
  eventType       String   @map("event_type")
  eventDate       DateTime @map("event_date")
  duration        Int      @default(60) // em minutos
  location        String?
  status          String   @default("pending") // pending, confirmed, completed, cancelled
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relacoes
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  deal            Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([eventDate])
  @@index([status])
  @@index([clientId])
  @@map("bookings")
}

// Document - PDFs gerados e enviados
model Document {
  id          String   @id @default(cuid())
  clientId    String   @map("client_id")
  dealId      String?  @map("deal_id")
  type        String   // contract, quote, invoice, moodboard, other
  title       String
  filename    String
  storageUrl  String   @map("storage_url")
  sentAt      DateTime? @map("sent_at")
  status      String   @default("draft") // draft, sent, viewed, signed
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relacoes
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  deal        Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@map("documents")
}

// Template - modelos de documentos para geracao de PDF
model Template {
  id          String   @id @default(cuid())
  type        String   // contract, quote, invoice
  title       String
  bodyHtml    String   @map("body_html")
  variables   String   // string JSON com nomes das variaveis
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("templates")
}

// Package - pacotes de servico pre-registrados para propostas
model Package {
  id           String   @id @default(cuid())
  name         String
  description  String
  price        Float
  currency     String   @default("BRL")
  deliverables String   // string JSON dos itens entregaveis
  duration     Int      // em horas
  category     String   @default("photography") // photography, videography, both
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("packages")
}

// ProposalTemplate - modelos para propostas
model ProposalTemplate {
  id              String   @id @default(cuid())
  name            String
  description     String?
  defaultTerms    String?  @map("default_terms")
  defaultPackages String?  @map("default_packages") // array JSON de IDs de pacotes
  coverImage      String?  @map("cover_image")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relacoes
  proposals       Proposal[]

  @@map("proposal_templates")
}

// Proposal - propostas de negocios para negociacao
model Proposal {
  id              String   @id @default(cuid())
  clientId        String   @map("client_id")
  dealId          String?  @map("deal_id") // link opcional para um negocio especifico
  templateId      String?  @map("template_id")
  title           String
  description     String?
  status          String   @default("draft") // draft, sent, viewed, accepted, rejected, expired
  packages        String   // array JSON de pacotes selecionados com precos customizados
  customItems     String?  @map("custom_items") // array JSON de itens personalizados
  portfolioLinks  String?  @map("portfolio_links") // array JSON de links do portfolio
  terms           String?  // termos e condicoes customizados
  validUntil      DateTime? @map("valid_until")
  totalValue      Float    @default(0) @map("total_value")
  currency        String   @default("BRL")
  notes           String?
  sentAt          DateTime? @map("sent_at")
  viewedAt        DateTime? @map("viewed_at")
  respondedAt     DateTime? @map("responded_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relacoes
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  deal            Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)
  template        ProposalTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([status])
  @@map("proposals")
}

// DashboardSettings - configuracoes do dashboard
model DashboardSettings {
  id              String   @id @default(cuid())
  businessName    String   @default("My Studio") @map("business_name")
  currency        String   @default("BRL")
  timezone        String   @default("America/Sao_Paulo")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("dashboard_settings")
}
