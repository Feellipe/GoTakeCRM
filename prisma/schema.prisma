// GoTakeCRM — Unified PostgreSQL Schema (Supabase)
// Single schema for all environments (dev, preview, production).
// Environment separation via DATABASE_URL pointing to different Supabase projects.
//
// Dev/Preview → gotakecrm-demo Supabase project
// Production  → gotakecrm-prod Supabase project

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
  connectionLimit = 1
}

// ═══════════════════════════════════════════════════════════════════
// Multi-Tenant Core Models
// ═══════════════════════════════════════════════════════════════════

// User — application-level user (separate from NextAuth session)
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  passwordHash  String?  @map("password_hash")
  avatar        String?
  googleId      String?  @unique @map("google_id")
  lastLoginAt   DateTime? @map("last_login_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  organizations UserOrganization[]

  @@map("users")
}

// Organization — tenant isolation unit
model Organization {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  whatsappPhone   String?  @map("whatsapp_phone")
  whatsappToken   String?  @map("whatsapp_token")
  whatsappPhoneId String?  @map("whatsapp_phone_id")
  stripeSecretKey String?  @map("stripe_secret_key")
  stripePublicKey String?  @map("stripe_public_key")
  stripeWebhookSecret String? @map("stripe_webhook_secret")
  plan            String   @default("solo") // solo, pro, agency
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  members            UserOrganization[]
  clients            Client[]
  deals              Deal[]
  conversations      Conversation[]
  bookings           Booking[]
  documents          Document[]
  templates          Template[]
  packages           Package[]
  proposalTemplates  ProposalTemplate[]
  proposals          Proposal[]
  dashboardSettings  DashboardSettings[]
  receivedShares     ClientShare[] @relation("ReceivedShares")

  @@map("organizations")
}

// UserOrganization — many-to-many with role
model UserOrganization {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  organizationId String   @map("organization_id")
  role           String   @default("owner") // owner, admin, member, viewer
  createdAt      DateTime @default(now()) @map("created_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@map("user_organizations")
}

// ClientShare — cross-org collaboration (full-client subtree sharing)
model ClientShare {
  id                  String   @id @default(cuid())
  clientId            String   @map("client_id")
  sharedToOrgId       String   @map("shared_to_org_id") // which org gets access
  grantedBy           String   @map("granted_by")       // which user shared it
  createdAt           DateTime @default(now()) @map("created_at")

  client              Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  sharedToOrg         Organization @relation("ReceivedShares", fields: [sharedToOrgId], references: [id], onDelete: Cascade)

  @@unique([clientId, sharedToOrgId])
  @@index([clientId])
  @@index([sharedToOrgId])
  @@map("client_shares")
}

// ═══════════════════════════════════════════════════════════════════
// Business Models (top-level — have organizationId)
// ═══════════════════════════════════════════════════════════════════

// Client — represents a customer (filmmaker/photographer client)
model Client {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  phone          String   @unique
  name           String
  email          String?
  eventType      String   @map("event_type")   // wedding, corporate, portrait, product, etc.
  notes          String?
  source         String   @default("whatsapp") // whatsapp, referral, website, instagram, other
  status         String   @default("active")   // active, lead, inactive
  avatar         String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deals          Deal[]
  conversations  Conversation[]
  bookings       Booking[]
  documents      Document[]
  proposals      Proposal[]
  shares         ClientShare[]

  @@index([organizationId])
  @@index([status])
  @@map("clients")
}

// Deal — the central entity linking all project data
model Deal {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  clientId       String   @map("client_id")
  title          String
  description    String?
  status         String   @default("new") // new, briefing, quoting, production, completed
  value          Float    @default(0)
  currency       String   @default("BRL")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  briefings      Briefing[]
  expenses       Expense[]
  revenue        Revenue[]
  bookings       Booking[]
  documents      Document[]
  proposals      Proposal[]

  @@index([organizationId])
  @@index([status])
  @@index([clientId])
  @@map("deals")
}

// Conversation — WhatsApp conversation threads
model Conversation {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  clientId       String   @map("client_id")
  status         String   @default("active") // active, closed
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  messages       Message[]

  @@index([organizationId])
  @@index([clientId])
  @@map("conversations")
}

// Booking — calendar bookings/shoots
model Booking {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  clientId       String    @map("client_id")
  dealId         String?   @map("deal_id")
  eventType      String    @map("event_type")
  eventDate      DateTime  @map("event_date")
  duration       Int       @default(60) // in minutes
  location       String?
  status         String    @default("pending") // pending, confirmed, completed, cancelled
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  deal           Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([eventDate])
  @@index([status])
  @@index([clientId])
  @@map("bookings")
}

// Document — PDFs generated and sent
model Document {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  clientId       String    @map("client_id")
  dealId         String?   @map("deal_id")
  type           String    // contract, quote, invoice, moodboard, other
  title          String
  filename       String
  storageUrl     String    @map("storage_url")
  sentAt         DateTime? @map("sent_at")
  status         String    @default("draft") // draft, sent, viewed, signed
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  deal           Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([clientId])
  @@map("documents")
}

// Template — document templates for PDF generation
model Template {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  type           String   // contract, quote, invoice
  title          String
  bodyHtml       String   @map("body_html")
  variables      String   // JSON string of variable names
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("templates")
}

// Package — pre-registered service packages for proposals
model Package {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  description    String
  price          Float
  currency       String   @default("BRL")
  deliverables   String   // JSON string of deliverable items
  duration       Int      // in hours
  category       String   @default("photography") // photography, videography, both
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("packages")
}

// ProposalTemplate — templates for proposals
model ProposalTemplate {
  id              String   @id @default(cuid())
  organizationId  String   @map("organization_id")
  name            String
  description     String?
  defaultTerms    String?  @map("default_terms")
  defaultPackages String?  @map("default_packages") // JSON array of package IDs
  coverImage      String?  @map("cover_image")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  proposals      Proposal[]

  @@index([organizationId])
  @@map("proposal_templates")
}

// Proposal — deal proposals for negotiation
model Proposal {
  id              String    @id @default(cuid())
  organizationId  String    @map("organization_id")
  clientId        String    @map("client_id")
  dealId          String?   @map("deal_id")
  templateId      String?   @map("template_id")
  title           String
  description     String?
  status          String    @default("draft") // draft, sent, viewed, accepted, rejected, expired
  packages        String    // JSON array of selected packages with custom prices
  customItems     String?   @map("custom_items")
  portfolioLinks  String?   @map("portfolio_links")
  terms           String?
  validUntil      DateTime? @map("valid_until")
  totalValue      Float     @default(0) @map("total_value")
  currency        String    @default("BRL")
  notes           String?
  sentAt          DateTime? @map("sent_at")
  viewedAt        DateTime? @map("viewed_at")
  respondedAt     DateTime? @map("responded_at")
  paymentLink     String?   @map("payment_link")
  paymentStatus   String    @default("none") @map("payment_status") // none, pending, paid, failed
  stripeSessionId String?   @map("stripe_session_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  deal           Deal?            @relation(fields: [dealId], references: [id], onDelete: SetNull)
  template       ProposalTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([clientId])
  @@index([status])
  @@map("proposals")
}

// DashboardSettings — per-organization dashboard configuration
model DashboardSettings {
  id             String   @id @default(cuid())
  organizationId String   @unique @map("organization_id")
  businessName   String   @default("My Studio") @map("business_name")
  currency       String   @default("BRL")
  timezone       String   @default("America/Sao_Paulo")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("dashboard_settings")
}

// ═══════════════════════════════════════════════════════════════════
// Child Models (accessed through parent — no organizationId needed)
// ═══════════════════════════════════════════════════════════════════

// Briefing — creative requirements captured per project (child of Deal)
model Briefing {
  id        String   @id @default(cuid())
  dealId    String   @map("deal_id")
  content   String
  author    String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@map("briefings")
}

// Expense — project-specific expenses (child of Deal)
model Expense {
  id          String   @id @default(cuid())
  dealId      String   @map("deal_id")
  category    String   // equipment, location, crew, props, travel, other
  description String
  amount      Float
  currency    String   @default("BRL")
  date        DateTime @default(now())
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@map("expenses")
}

// Revenue — project payments received (child of Deal)
model Revenue {
  id          String   @id @default(cuid())
  dealId      String   @map("deal_id")
  description String?
  amount      Float
  currency    String   @default("BRL")
  date        DateTime @default(now())
  status      String   @default("received") // pending, received
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@map("revenues")
}

// Message — individual messages in conversations (child of Conversation)
model Message {
  id             String   @id @default(cuid())
  conversationId String   @map("conversation_id")
  direction      String   // inbound, outbound
  type           String   // text, image, document, interactive
  content        String
  status         String   @default("sent") // sent, delivered, read
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}

// ═══════════════════════════════════════════════════════════════════
// WhatsApp Slash Commands
// ═══════════════════════════════════════════════════════════════════

// CommandSession — tracks multi-step WhatsApp command state
model CommandSession {
  id        String   @id @default(cuid())
  phone     String
  command   String
  step      Int      @default(0)
  data      Json     @default("{}")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([phone, expiresAt])
  @@map("command_sessions")
}
